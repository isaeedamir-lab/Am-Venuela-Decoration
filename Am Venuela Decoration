                unit: "للقطعة",
                image: "https://images.unsplash.com/photo-1583847268964-b28dc8f51f92?w=600&auto=format&fit=crop&q=80",
                description: "إطارات وبانوهات جدران جاهزة للدهان تضفي طابعاً ملكياً وفخماً على غرف الاستقبال والممرات.",
                colors: [
                    { name: "أبيض أساس (جاهز للدهان)", stock: 120 },
                    { name: "ذهبي معتق فخم", stock: 35 }
                ]
            },
            {
                id: 4,
                title: "شيبورد خشبي مطفي عالي الجودة",
                category: "شيبورد",
                price: 220,
                unit: "للوح الكامل",
                image: "https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?w=600&auto=format&fit=crop&q=80",
                description: "ألواح شيبورد مثالية لتصميم المطابخ الحديثة والخزائن المبتكرة بألوان عصرية متناسقة.",
                colors: [
                    { name: "أبيض مطفي (Silk)", stock: 25 },
                    { name: "سنديان فاتح", stock: 14 },
                    { name: "رمادي تفحمي (Anthracite)", stock: 9 }
                ]
            },
            {
                id: 5,
                title: "بديل حجر طبيعي بارز الجدران",
                category: "بديل الحجر",
                price: 150,
                unit: "للمتر المربع",
                image: "https://images.unsplash.com/photo-1541123437800-1bb1317badc2?w=600&auto=format&fit=crop&q=80",
                description: "ألواح خفيفة الوزن تعطي مظهر الحجر الطبيعي الخشن للواجهات الداخلية والدفايات.",
                colors: [
                    { name: "حجر كريمي جيري", stock: 22 },
                    { name: "حجر رمادي جبلي", stock: 16 }
                ]
            },
            {
                id: 6,
                title: "بانل جداري مودرن مع ليد مخفي",
                category: "بانوهات",
                price: 250,
                unit: "للقطعة",
                image: "https://images.unsplash.com/photo-1507089947368-19c1da9775ae?w=600&auto=format&fit=crop&q=80",
                description: "تنسيق هندسي رائع يدمج بديل الخشب مع خطوط الإضاءة المخفية لإطلالة مستقبلية رائعة.",
                colors: [
                    { name: "خشبي فاتح بإضاءة دافئة", stock: 10 },
                    { name: "أسود فاحم بإضاءة صفراء", stock: 7 }
                ]
            }
        ];

        let cart = [];
        let selectedProduct = null;
        let selectedColorIndex = 0;

        window.addEventListener('load', () => {
            setTimeout(() => {
                const splash = document.getElementById('splash-screen');
                splash.style.opacity = '0';
                setTimeout(() => splash.remove(), 500);
            }, 800);
            renderProducts(products);
            renderFeatured();
        });

        function switchTab(tabId) {
            document.querySelectorAll('main > section').forEach(sec => sec.classList.add('hidden'));
            document.getElementById(`tab-${tabId}`).classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.classList.remove('text-amber-600');
                btn.classList.add('text-slate-400');
                if(btn.getAttribute('data-tab') === tabId) {
                    btn.classList.add('text-amber-600');
                    btn.classList.remove('text-slate-400');
                }
            });

            if(tabId === 'cart') renderCart();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function renderProducts(list) {
            const container = document.getElementById('shop-products');
            if(list.length === 0) {
                container.innerHTML = `<div class="col-span-2 text-center py-10 text-xs text-slate-400">لا توجد منتجات مطابقة للبحث</div>`;
                return;
            }
            container.innerHTML = list.map(p => `
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden flex flex-col justify-between group cursor-pointer hover:shadow-md transition" onclick="openModal(${p.id})">
                    <div class="relative h-36 bg-slate-100 overflow-hidden">
                        <img src="${p.image}" alt="${p.title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                        <span class="absolute top-2 right-2 bg-slate-900/70 backdrop-blur-sm text-white text-[9px] font-bold px-2 py-0.5 rounded-full">${p.category}</span>
                    </div>
                    <div class="p-3 flex flex-col justify-between flex-1">
                        <div>
                            <h4 class="font-bold text-slate-900 text-xs mb-1 line-clamp-1">${p.title}</h4>
                            <span class="text-[10px] text-amber-700 bg-amber-50 px-2 py-0.5 rounded font-semibold inline-block mb-1">ألوان متعددة متاحة</span>
                        </div>
                        <div class="flex justify-between items-center mt-auto pt-2 border-t border-slate-50">
                            <span class="text-xs font-extrabold text-amber-600">${p.price} ₪</span>
                            <span class="text-[10px] text-slate-500 font-bold">اختر اللون والكمية</span>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function renderFeatured() {
            const container = document.getElementById('featured-products');
            const featured = products.slice(0, 4);
            container.innerHTML = featured.map(p => `
                <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden flex flex-col justify-between cursor-pointer hover:shadow-md transition" onclick="openModal(${p.id})">
                    <div class="relative h-32 bg-slate-100">
                        <img src="${p.image}" alt="${p.title}" class="w-full h-full object-cover">
                    </div>
                    <div class="p-3">
                        <h4 class="font-bold text-slate-900 text-xs mb-1 line-clamp-1">${p.title}</h4>
                        <div class="flex justify-between items-center mt-2">
                            <span class="text-xs font-extrabold text-amber-600">${p.price} ₪</span>
                            <span class="text-[10px] text-slate-400">${p.unit}</span>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function filterCategory(cat) {
            document.querySelectorAll('.category-btn').forEach(btn => {
                btn.classList.remove('bg-amber-600', 'text-white', 'shadow-sm');
                btn.classList.add('bg-white', 'text-slate-700', 'border', 'border-slate-200');
                if(btn.textContent.includes(cat) || (cat === 'الكل' && btn.textContent === 'الكل')) {
                    btn.classList.add('bg-amber-600', 'text-white', 'shadow-sm');
                    btn.classList.remove('bg-white', 'text-slate-700', 'border', 'border-slate-200');
                }
            });

            if(cat === 'الكل') {
                renderProducts(products);
            } else {
                const filtered = products.filter(p => p.category.includes(cat));
                renderProducts(filtered);
            }
        }

        function searchProducts() {
            const query = document.getElementById('search-input').value.toLowerCase();
            const filtered = products.filter(p => 
                p.title.toLowerCase().includes(query) || 
                p.category.toLowerCase().includes(query) || 
                p.description.toLowerCase().includes(query) ||
                p.colors.some(c => c.name.toLowerCase().includes(query))
            );
            renderProducts(filtered);
        }

        function openModal(id) {
            selectedProduct = products.find(item => item.id === id);
            if(!selectedProduct) return;
            selectedColorIndex = 0;

            document.getElementById('modal-img').src = selectedProduct.image;
            document.getElementById('modal-category').innerText = selectedProduct.category;
            document.getElementById('modal-title').innerText = selectedProduct.title;
            document.getElementById('modal-desc').innerText = selectedProduct.description;
            document.getElementById('modal-price').innerText = `${selectedProduct.price} ₪ (${selectedProduct.unit})`;

            renderModalColors();
            document.getElementById('product-modal').classList.remove('hidden');
        }

        function renderModalColors() {
            const container = document.getElementById('modal-colors-container');
            container.innerHTML = selectedProduct.colors.map((c, idx) => `
                <div onclick="selectColor(${idx})" class="p-2.5 rounded-xl border cursor-pointer transition flex flex-col justify-between ${selectedColorIndex === idx ? 'border-amber-600 bg-amber-50/50' : 'border-slate-200 bg-slate-50'}">
                    <span class="font-bold text-slate-800">${c.name}</span>
                    <span class="text-[10px] text-slate-500 mt-1">المتبقي: <strong class="${c.stock < 10 ? 'text-red-600' : 'text-green-600'}">${c.stock}</strong> وحدة</span>
                </div>
            `).join('');
        }

        function selectColor(idx) {
            selectedColorIndex = idx;
            renderModalColors();
        }

        function closeModal() {
            document.getElementById('product-modal').classList.add('hidden');
        }

        function addCurrentToCart() {
            if(!selectedProduct) return;
            const chosenColor = selectedProduct.colors[selectedColorIndex];
            
            const cartItemId = `${selectedProduct.id}-${chosenColor.name}`;
            const existing = cart.find(item => item.cartItemId === cartItemId);
            
            if(existing) {
                if(existing.qty < chosenColor.stock) {
                    existing.qty += 1;
                    showToast("تم تحديث الكمية في السلة");
                } else {
                    showToast("عذراً، الكمية المطلوبة تتجاوز المتبقي بالمخزون");
                    return;
                }
            } else {
                cart.push({
                    cartItemId: cartItemId,
                    id: selectedProduct.id,
                    title: selectedProduct.title,
                    price: selectedProduct.price,
                    image: selectedProduct.image,
                    colorName: chosenColor.name,
                    maxStock: chosenColor.stock,
                    qty: 1
                });
                showToast("تمت الإضافة بنجاح إلى السلة");
            }

            updateCartBadge();
            closeModal();
        }

        function updateCartBadge() {
            const badge = document.getElementById('cart-badge');
            const totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
            if(totalCount > 0) {
                badge.innerText = totalCount;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.innerText = msg;
            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 2000);
        }

        function renderCart() {
            const container = document.getElementById('cart-items');
            const summary = document.getElementById('cart-summary');
            
            if(cart.length === 0) {
                container.innerHTML = `
                    <div class="bg-white p-8 rounded-2xl text-center space-y-3 border border-slate-100">
                        <div class="w-14 h-14 bg-amber-50 text-amber-600 rounded-full flex items-center justify-center mx-auto text-xl">
                            <i class="fa-solid fa-cart-shopping"></i>
                        </div>
                        <h4 class="font-bold text-slate-800 text-sm">سلة المشتريات فارغة</h4>
                        <p class="text-xs text-slate-400">تصفح المعرض وأضف العيينات والديكورات والألوان المطلوبة.</p>
                        <button onclick="switchTab('shop')" class="bg-amber-600 text-white text-xs font-bold px-4 py-2 rounded-xl shadow">الانتقال للمعرض</button>
                    </div>
                `;
                summary.classList.add('hidden');
                return;
            }

            summary.classList.remove('hidden');
            container.innerHTML = cart.map(item => `
                <div class="bg-white p-3 rounded-2xl shadow-sm border border-slate-100 flex items-center justify-between">
                    <div class="flex items-center space-x-3 space-x-reverse">
                        <img src="${item.image}" alt="${item.title}" class="w-14 h-14 object-cover rounded-xl">
                        <div>
                            <h4 class="font-bold text-slate-900 text-xs line-clamp-1">${item.title}</h4>
                            <span class="text-[10px] text-amber-700 bg-amber-50 px-1.5 py-0.5 rounded font-semibold block my-0.5">اللون: ${item.colorName}</span>
                            <span class="text-xs text-amber-600 font-extrabold">${item.price} ₪</span>
                        </div>
                    </div>
                    <div class="flex items-center space-x-2 space-x-reverse">
                        <button onclick="changeQty('${item.cartItemId}', -1)" class="w-7 h-7 bg-slate-100 text-slate-600 rounded-lg flex items-center justify-center font-bold text-xs">-</button>
                        <span class="text-xs font-bold w-5 text-center">${item.qty}</span>
                        <button onclick="changeQty('${item.cartItemId}', 1)" class="w-7 h-7 bg-slate-100 text-slate-600 rounded-lg flex items-center justify-center font-bold text-xs">+</button>
                    </div>
                </div>
            `).join('');

            const total = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            document.getElementById('cart-total').innerText = `${total} ₪`;
        }

        function changeQty(cartItemId, delta) {
            const item = cart.find(i => i.cartItemId === cartItemId);
            if(item) {
                if(delta > 0 && item.qty >= item.maxStock) {
                    showToast("عذراً، وصلت للحد الأقصى للكمية المتبقية من هذا اللون");
                    return;
                }
                item.qty += delta;
                if(item.qty <= 0) {
                    cart = cart.filter(i => i.cartItemId !== cartItemId);
                }
            }
            updateCartBadge();
            renderCart();
        }

        function checkout() {
            if(cart.length === 0) return;
            const deliveryType = document.querySelector('input[name="delivery-type"]:checked').value;
            const total = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);
            
            let message = `السلام عليكم، أرغب بطلب المنتجات التالية من معرض Am Venuela Decoration:\n\n`;
            cart.forEach(item => {
                message += `- ${item.title}\n  اللون: ${item.colorName} | الكمية: ${item.qty} | السعر: ${item.price * item.qty} ₪\n`;
            });
            message += `\nالمجموع الكلي: ${total} ₪\nطريقة الاستلام: ${deliveryType}\nموقعنا المطلوب للتوصيل أو الاستلام: الخليل - رأس طلعة ادعيس.`;

            const phone = "0595553523";
            const url = `https://wa.me/970${phone.substring(1)}?text=${encodeURIComponent(message)}`;
            window.open(url, '_blank');
        }

        function submitConsultation(e) {
            e.preventDefault();
            const name = document.getElementById('c-name').value;
            const phone = document.getElementById('c-phone').value;
            const service = document.getElementById('c-service').value;
            const notes = document.getElementById('c-notes').value;

            const message = `طلب استشارة هندسية جديدة من Am Venuela Decoration:\n\nالاسم: ${name}\nالهاتف: ${phone}\nالخدمة: ${service}\nالتفاصيل: ${notes}`;
            const targetPhone = "0595553523";
            const url = `https://wa.me/970${targetPhone.substring(1)}?text=${encodeURIComponent(message)}`;
            window.open(url, '_blank');
        }
    </script>
</body>
</html>
